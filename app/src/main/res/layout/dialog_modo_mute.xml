<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#222222">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/mute_app"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Rango horario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editHoraInicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hora_init"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_dark_bg"
                android:padding="10dp"
                android:textSize="16sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editHoraFin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hora_fin"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#FFFFFF"
                android:background="@drawable/edittext_dark_bg"
                android:padding="10dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Checkboxes -->
        <CheckBox
            android:id="@+id/checkBoxRango"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_best_zones"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <CheckBox
            android:id="@+id/checkBoxMute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mute"
            android:textColor="#FFFFFF" />

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aceptar"
                android:minWidth="120dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancelar"
                android:minWidth="120dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
